{
  "name": "fantacalcio-highlight",
  "version": "0.1.0",
  "private": true,
  "description": "Video highlight e locandine delle giornate di fantacalcio, generati con Remotion",
  "type": "module",
  "scripts": {
    "app": "node app/server.mjs --apri",
    "studio": "remotion studio",
    "render:giornata": "node scripts/render-giornata.mjs",
    "render:uno": "remotion render Highlight-1 out/highlight-1.mp4",
    "locandina:uno": "remotion still Locandina-1 out/locandina-1.png",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
